{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Courier.db"
  },
  "UserSettings": {
    "AppName": "CourierBackend",
    "APIVersion": "1",
    "APIDescription": "API for Courier Backend"
  },
  "JwtSettings": {
    "SecretKey": "THIS_IS_A_SUPER_SECRET_KEY_CHANGE_IT",
    "Issuer": "CourierBackend",
    "Audience": "CourierBackendUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 465,
    "Username": "username",
    "Password": "password",
    "FromEmail": "from@example.com",
    "FromName": "Courier Backend"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [ "127.0.0.1", "::1/10", "192.168.0.0/24" ],
    "EndpointWhitelist": [ "get:/api/license", "*:/api/status" ],
    "ClientWhitelist": [ "dev-id-1", "dev-id-2" ],
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/login",
        "Period": "1m",
        "Limit": 2
      },
      {
        "Endpoint": "*:/api/auth/forgot-password",
        "Period": "1m",
        "Limit": 2
      },
      {
        "Endpoint": "*:/api/package/track",
        "Period": "1m",
        "Limit": 5
      }
    ],
    "QuotaExceededResponse": {
      "Content": {
        "message": "Too many requests"
      },
      "ContentType": "application/json",
      "StatusCode": 429
    }
  },
  "IpRateLimitPolicies": {
    "IpRules": [],
    "IpWhitelist": [
      "127.0.0.1",
      "::1"
    ]
  }
}